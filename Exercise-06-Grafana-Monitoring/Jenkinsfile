pipeline {
    agent any

    stages {
        stage('Pre-check Docker') {
            steps {
                sh 'docker --version'
                sh 'docker info'
            }
        }

        stage('Validate Files') {
            steps {
                sh 'test -f delivery_metrics.py'
                sh 'test -f prometheus.yml'
                sh 'test -f alert_rules.yml'
                sh 'python3 -m py_compile delivery_metrics.py'
            }
        }

        stage('Build Docker Image') {
            steps {
                sh 'docker build -t delivery-metrics:latest .'
            }
        }

        stage('Verify Monitoring Stack') {
            steps {
                sh 'docker ps'
                echo 'Prometheus and Grafana should already be running.'
            }
        }
    }

    post {
        success {
            echo 'Delivery monitoring pipeline completed successfully.'
        }
        failure {
            echo 'Pipeline failed. Review the console output.'
        }
    }
}
